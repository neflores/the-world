import 'package:altar_tabletop_api_transport/altar_tabletop_api_transport.dart';
import 'package:world/world.dart';

/// Example host adapter compiled against the real generated Altar DTO.
/// City, direction, plot, address and appearance are a separate safe projection:
/// PublicOrganizationProfile currently does not contain those fields.
WorldLocation projectOrganization(
  PublicOrganizationProfile profile, {
  required String cityId,
  required CityDistrict district,
  required int plot,
  required String address,
  WorldAppearance appearance = const WorldAppearance(),
}) {
  if (profile.kind == OrganizationKind.unknownDefaultOpenApi) {
    throw ArgumentError('Unsupported organization kind');
  }
  final physical = profile.kind == OrganizationKind.physicalClub;
  if (physical && address.trim().isEmpty) {
    throw ArgumentError('Physical club address is required');
  }
  return WorldLocation(
    id: profile.organizationProfileId,
    cityId: cityId,
    name: profile.displayName,
    description: profile.shortDescription,
    kind: physical ? WorldLocationKind.physicalClub : WorldLocationKind.community,
    address: address,
    district: district,
    plot: plot,
    appearance: appearance,
  );
}

/// Professional identity stays distinct from the owner's personal avatar.
WorldLocation projectProfessional(
  PublicProfessionalProfile profile, {
  required String cityId,
  required CityDistrict district,
  required int plot,
  WorldAppearance appearance = const WorldAppearance(),
}) {
  if (profile.kind == ProfessionalKind.unknownDefaultOpenApi) {
    throw ArgumentError('Unsupported professional kind');
  }
  return WorldLocation(
    id: profile.professionalProfileId,
    cityId: cityId,
    name: profile.displayName,
    description: profile.shortDescription,
    kind: profile.kind == ProfessionalKind.master
        ? WorldLocationKind.master
        : WorldLocationKind.creator,
    district: district,
    plot: plot,
    appearance: appearance,
    representativeId: 'professional:${profile.professionalProfileId}',
  );
}
